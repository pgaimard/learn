# --- Reverse proxy ---

# Adresse servie par le reverse proxy. « localhost » en local (certificat interne),
# le nom de domaine public en production (certificat Let's Encrypt automatique).
SITE_ADDRESS=localhost

# --- Base PostgreSQL ---

DATABASE_NAME=learn
DATABASE_USER=learn
DATABASE_PASSWORD=change-me

# --- Session ---

# Secret de signature du cookie de session, 32 caractères minimum.
# Générer avec : openssl rand -hex 32
SESSION_SECRET=change-me-avec-openssl-rand-hex-32

# --- API lancée hors Docker (npm run start:dev, tests, migrations) ---
# Dans Docker Compose, ces valeurs sont fixées par compose.yaml.

# Environnement d'exécution : development, test ou production
NODE_ENV=development

# Port d'écoute de l'API
PORT=3000

# Accès à la base, publiée sur l'hôte par compose.dev.yaml
DATABASE_HOST=localhost
DATABASE_PORT=5432

# --- Développement uniquement ---
# Décommenter pour que « docker compose » publie aussi la base sur l'hôte (127.0.0.1),
# ce qu'exigent l'API, les tests et les migrations lancés hors Docker.
# COMPOSE_FILE=compose.yaml:compose.dev.yaml
